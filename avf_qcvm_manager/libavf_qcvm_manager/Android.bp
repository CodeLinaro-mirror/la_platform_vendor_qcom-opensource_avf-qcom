rust_library {
    name: "libavf_qcvm_manager",
    srcs: ["src/lib.rs"],
    crate_name: "avf_qcvm_manager",
    rustlibs: [
        "vendor.qti.AvfQcvmManager-V1-rust",
        "libavf_bindgen",
        "libbinder_rs",
        "liblog_rust",
        "libserde_json",
        "libserde",
        "libanyhow",
        "liblogger",
        "libbase_rust",
        "librustutils",
        "libzerocopy",
        "libnix",
        "libguest_agent_client",
    ],
    shared_libs: ["libavf"],
    vendor: true,
    prefer_rlib: true,

    enabled: select(soong_config_variable("qti_fwk_valueadds", "fwk_supports_full_valueadds"), {
        "disabled": false,
        default: true,
    }),

}
